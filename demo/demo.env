# Overrides applied on top of each service's own .env when running the demo.
# godotenv / python-dotenv do not override variables already in the
# environment, so exporting these first points every service at local infra.
export PG_HOST=localhost
export PG_PORT=5433
export PG_USER=projectup
export PG_PASSWORD=projectup
export PG_DATABASE=projectup_demo
export DATABASE_URL=postgresql://projectup:projectup@localhost:5433/projectup_demo
export REDIS_HOST=localhost
export REDIS_PORT=6380
export REDIS_URL=redis://localhost:6380/0
export AI_SERVICE_URL=http://localhost:8000
export AI_AGENT_URL=http://localhost:8000

# Uploads go to the MinIO container instead of AWS S3 (see docker-compose.yml).
export AWS_REGION=us-east-1
export AWS_ACCESS_KEY_ID=projectup
export AWS_SECRET_ACCESS_KEY=projectup-minio
export AWS_BUCKET_NAME=projectup
export S3_ENDPOINT=http://localhost:9010
export S3_PUBLIC_BASE_URL=http://localhost:9010/projectup
export VITE_FILE_BASE_URL=http://localhost:9010/projectup/
