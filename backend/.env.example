# Application Configuration
APP_MODE=development
PORT=8080
BASE_URL=http://localhost:8080
DOMAIN=localhost

# Database Configuration (Primary)
DB_HOST=localhost
DB_PORT=5432
DB_USER=projectup
DB_PASSWORD=password
DB_NAME=projectup

# PostgreSQL Alternative Config (if using different env names)
PG_HOST=localhost
PG_PORT=5432
PG_USER=projectup
PG_PASSWORD=password
PG_DATABASE=projectup

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-secret-key-here
REFRESH_SECRET=your-refresh-secret-key-here
JWT_ACCESS_TOKEN_EXPIRY=24h
JWT_REFRESH_TOKEN_EXPIRY=720h

# AWS Configuration
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name
AWS_BUCKET_NAME=your-bucket-name
# Optional: use an S3-compatible store such as MinIO instead of AWS S3.
# S3_PUBLIC_BASE_URL is where objects are served from, bucket included.
# S3_ENDPOINT=http://localhost:9010
# S3_PUBLIC_BASE_URL=http://localhost:9010/projectup
AWS_EMAIL_REGION=us-east-1

# RabbitMQ (optional)
AWS_RABBITMQ_URL=amqp://user:password@localhost:5672/

# Email Configuration
FROM_EMAIL=noreply@projectup.me
EMAIL_PASSWORD=your-email-password

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Mailgun (alternative email provider)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.projectup.me
MAILGUN_SECRET=your-mailgun-secret

# Mailjet (alternative email provider)
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
MAILJET_SMTP_SERVER=in-v3.mailjet.com
MAILJET_SMTP_PORT=587

# Frontend URL
FRONTEND_URL=http://localhost:5173

# AI Agent URL
AI_AGENT_URL=http://localhost:8000

# OAuth2 Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Stripe Configuration
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Stripe Product IDs
STRIPE_PRODUCT_BASIC=prod_xxxxxxxxxxxxx
STRIPE_PRODUCT_TEAM=prod_xxxxxxxxxxxxx
STRIPE_PRODUCT_PRO=prod_xxxxxxxxxxxxx
STRIPE_PRODUCT_ENTERPRISE=prod_xxxxxxxxxxxxx