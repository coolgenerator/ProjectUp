# API Configuration
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080

# AI Service Configuration
# All AI/Service related requests should go directly to the AI Service
VITE_AI_SERVICE_URL=http://localhost:8888
VITE_AI_SERVICE_WS_URL=ws://localhost:8888

# AI Service API Versions
VITE_AI_SERVICE_API_V1=/api/v1
VITE_AI_SERVICE_API_V2=/api/v2

# AI Features Configuration
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_AI_STREAMING=true
VITE_MAX_REFINEMENTS=3
VITE_DEFAULT_DURATION=20
VITE_DEFAULT_DIFFICULTY=intermediate
VITE_DEFAULT_BACKGROUND=beginner
VITE_AI_REQUEST_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_DARK_MODE=true
VITE_POLLING_INTERVAL=2000

# OAuth Providers (optional)
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=

# Third-party APIs (optional)
VITE_UNSPLASH_ACCESS_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Payment Integration (optional)
VITE_STRIPE_PUBLISHABLE_KEY=

# Analytics (optional)
VITE_GA_TRACKING_ID=
VITE_MIXPANEL_TOKEN=

# Error Tracking (optional)
VITE_SENTRY_DSN=

# Environment
VITE_ENV=development
VITE_PUBLIC_URL=http://localhost:5173

# Development
VITE_DEBUG=false

# Public base URL for uploaded files (covers, avatars, media).
# Leave unset to use the AWS S3 bucket; for local MinIO use:
# VITE_FILE_BASE_URL=http://localhost:9000/projectup/
