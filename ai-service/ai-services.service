[Unit]
Description=AI Service - ProjectUp AI Agent API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ai-services
Environment="PATH=/home/ubuntu/venv/bin:/usr/local/bin:/usr/bin:/bin"
# Make .env optional - only loaded if file exists
EnvironmentFile=-/home/ubuntu/ai-services/.env

# Use uvicorn directly with single worker (more stable for production)
ExecStart=/home/ubuntu/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8888 --workers 1

# Restart policy
Restart=always
RestartSec=10

# Logging
StandardOutput=append:/var/log/ai-services.log
StandardError=append:/var/log/ai-services-error.log

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
