# AI Agent Environment Variables
# Copy this file to .env and update with your values

# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================

# Environment mode: development, staging, production
# In production mode, Swagger UI will be disabled for security
ENVIRONMENT=development

# API Documentation (Swagger UI)
# Set to false in production for security
# When false, /docs, /redoc, and /openapi.json endpoints will be disabled
ENABLE_SWAGGER=true

# Google Cloud Platform / Vertex AI Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_LOCATION=us-central1

# Credentials Configuration:
# - Development: Use relative path to your service account JSON file
#   Example: config/project-up66-xxx.json (your actual GCP credentials file)
# - Production: CI/CD automatically creates config/credential.json from GCP_SERVICE_ACCOUNT_KEY secret
#   Example: /home/ubuntu/ai-services/config/credential.json
GOOGLE_APPLICATION_CREDENTIALS=config/your-service-account-key.json

# Alternative: Use JSON string directly (set by CI/CD from GitHub secrets)
# GCP_CREDENTIALS_JSON='{"type": "service_account", ...}'

# Vertex AI Model Configuration
VERTEX_AI_MODEL=gemini-1.5-flash
VERTEX_AI_EMBEDDING_MODEL=text-embedding-004
VERTEX_AI_TEMPERATURE=0.7
VERTEX_AI_MAX_OUTPUT_TOKENS=8192
VERTEX_AI_TOP_P=0.95
VERTEX_AI_TOP_K=40

# Safety Settings
VERTEX_AI_ENABLE_SAFETY=true
VERTEX_AI_SAFETY_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE

# Advanced Vertex AI Features
VERTEX_AI_ENABLE_GROUNDING=false
VERTEX_AI_ENABLE_CODE_EXECUTION=false
VERTEX_AI_RESPONSE_MIME_TYPE=text/plain

# Rate Limiting
VERTEX_AI_RPM=60
VERTEX_AI_TPM=1000000

# Retry Configuration
VERTEX_AI_MAX_RETRIES=3
VERTEX_AI_RETRY_DELAY=1.0

# Default LLM Provider
DEFAULT_LLM_PROVIDER=vertex_ai
DEFAULT_LLM_MODEL=gemini-1.5-flash
DEFAULT_EMBEDDING_MODEL=text-embedding-004

# General LLM Settings
LLM_TEMPERATURE=0.7
MAX_TOKENS=8192

# Storage Configuration
STORAGE_BACKEND=local
STORAGE_PATH=./storage
VECTOR_STORE_TYPE=faiss

# Workflow Configuration
MAX_RETRIES=3
TIMEOUT_SECONDS=300
CHECKPOINT_INTERVAL=5

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=ai-agent.log

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# Feature Flags
ENABLE_CACHING=true
ENABLE_TELEMETRY=false
ENABLE_DEBUG=false

# Legacy/Fallback API Keys (optional)
ANTHROPIC_API_KEY=
TAVILY_API_KEY=