# Production Environment Variables for AI Service
# Copy this file to .env.production (gitignored), fill in real values,
# then store its content in GitHub Secrets as AI_SERVICE_ENV_FILE

# Application
APP_MODE=production
PORT=8888
BASE_URL=https://your-domain.com
DOMAIN=your-domain.com

# JWT Secrets
JWT_SECRET=<jwt_secret>
REFRESH_SECRET=<refresh_secret>

# Database (PostgreSQL on RDS)
PG_USER=postgres
PG_PASSWORD=<pg_password>
PG_HOST=your-db-host.rds.amazonaws.com
PG_DATABASE=projectup
PG_PORT=5432

# AWS Configuration
AWS_ACCESS_KEY_ID=<aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<aws_secret_access_key>
AWS_REGION=us-east-2
AWS_BUCKET_NAME=your-bucket
AWS_EMAIL_REGION=us-west-1

# Email Configuration
FROM_EMAIL=support@your-domain.com
EMAIL_PASSWORD=<email_password>

# Mailjet
MAILJET_API_KEY=<mailjet_api_key>
MAILJET_SECRET_KEY=<mailjet_secret_key>
MAILJET_SMTP_SERVER=in-v3.mailjet.com
MAILJET_SMTP_PORT=587

# Mailgun
MAILGUN_API_KEY=<mailgun_api_key>
MAILGUN_SECRET=<mailgun_secret>
MAILGUN_DOMAIN=mg.your-domain.com

# OAuth - Google
GOOGLE_CLIENT_ID=<google_client_id>
GOOGLE_CLIENT_SECRET=<google_client_secret>

# OAuth - Discord
DISCORD_CLIENT_ID=<discord_client_id>
DISCORD_CLIENT_SECRET=<discord_client_secret>

# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
GCP_PROJECT_ID=your-gcp-project
GCP_REGION=us-central1
GCP_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-pro
DEFAULT_LLM_PROVIDER=vertex_ai
DEFAULT_LLM_MODEL=gemini-2.5-pro
VERTEX_AI_TEMPERATURE=0.7
VERTEX_AI_MAX_OUTPUT_TOKENS=8192

# CORS Origins (production URLs)
CORS_ORIGINS=https://your-domain.com

# Service Account Key (automatically deployed by CI/CD from GCP_SERVICE_ACCOUNT_KEY secret)
# CI/CD creates this file from GCP_SERVICE_ACCOUNT_KEY GitHub secret
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
